{
  "name": "termcraft",
  "productName": "TermCraft",
  "version": "0.2.0",
  "description": "Free and open-source terminal and session manager: SSH2, Telnet, Rlogin, Serial, Raw TCP, local shells, SFTP, SCP, VNC and RDP, with tabs, port forwarding, jump hosts, button bars and scripting. Built with Rust and Tauri.",
  "author": {
    "name": "Gabriel Moreno",
    "email": "22067417+figgarden@users.noreply.github.com",
    "url": "https://github.com/figgarden"
  },
  "license": "GPL-2.0-or-later",
  "scripts": {
    "start": "cargo run --manifest-path src-tauri/Cargo.toml",
    "dev": "cargo tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node --test test/*.test.js",
    "test:e2e": "node scripts/e2e.js",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "audit": "npm audit --omit=dev && cargo audit --file src-tauri/Cargo.lock",
    "test:all": "npm run lint && npm test && npm run test:e2e && npm run audit",
    "dist": "cargo tauri build",
    "icons": "node scripts/build-icons.js",
    "screenshots": "node scripts/e2e.js --script scripts/screenshots.js",
    "notices": "node scripts/third-party-notices.js"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@novnc/novnc": "1.7.0",
    "@xterm/addon-fit": "0.12.0-beta.301",
    "@xterm/addon-image": "0.10.0-beta.301",
    "@xterm/addon-search": "0.17.0-beta.301",
    "@xterm/addon-unicode11": "0.10.0-beta.301",
    "@xterm/addon-web-links": "0.13.0-beta.301",
    "@xterm/xterm": "6.1.0-beta.304"
  },
  "devDependencies": {
    "ssh2": "^1.17.0"
  },
  "keywords": [
    "ssh",
    "terminal",
    "telnet",
    "serial",
    "sftp",
    "scp",
    "terminal-emulator",
    "session-manager",
    "vnc",
    "rdp",
    "tauri",
    "rust"
  ],
  "homepage": "https://github.com/figgarden/TermCraft",
  "repository": {
    "type": "git",
    "url": "https://github.com/figgarden/TermCraft.git"
  },
  "bugs": {
    "url": "https://github.com/figgarden/TermCraft/issues"
  },
  "allowScripts": {
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}
